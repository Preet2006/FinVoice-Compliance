    "end": 10.219999,
    "text": "ہیلو میں عمران بول رہا ہوں شاہ فنلیس سے آپ کے کرڈٹ کارڈ کے بارے میں کال کیا ہے"
   },
   {
    "seq": 1,
    "start": 10.219999,
    "end": 12.559999,
    "text": "پراکھان جی سے بات ہو رہی ہے"
   },
   {
    "seq": 2,
    "start": 12.559999,
    "end": 15.78,
    "text": "ہاں میں بڑا بول رہی ہوں"
   },
   {
    "seq": 3,
    "start": 15.78,
    "end": 22.0,
    "text": "میڈم آپ کے کرڈٹ کارڈ کا 62000 روپیا باقی ہے کب دے رہے ہو"
   },
   {
    "seq": 4,
    "start": 22.0,
    "end": 26.519999,
    "text": "ابھی پیسے نہیں ہے مجھے سوڑا ٹائم چاہیے"
   },
   {
    "seq": 5,
    "start": 26.519999,
    "end": 29.819998,
    "text": "آپ ہمیشہ یہی بولتے ہو"
   },
   {
    "seq": 6,
    "start": 29.819998,
    "end": 31.479998,
    "text": "کتنا ٹائم چاہیے"
   },
   {
    "seq": 7,
    "start": 31.479998,
    "end": 35.399998,
    "text": "بس ایک مہینہ دے دیجئے"
   },
   {
    "seq": 8,
    "start": 35.399998,
    "end": 37.899998,
    "text": "ایک مہینہ"
   },
   {
    "seq": 9,
    "start": 37.899998,
    "end": 40.66,
    "text": "آپ ہمیں بے وکوف سمجھتے ہو کیا"
   },
   {
    "seq": 10,
    "start": 40.66,
    "end": 44.219997,
    "text": "آپ ایسے بات نہ کیجئے"
   },
   {
    "seq": 11,
    "start": 44.219997,
    "end": 47.28,
    "text": "اگر کل تک پیسہ نہیں آیا"
   },
   {
    "seq": 12,
    "start": 47.28,
    "end": 49.339996,
    "text": "تو میں پولیس بھیج دوں گا"
   },
   {
    "seq": 13,
    "start": 49.339996,
    "end": 51.019997,
    "text": "اور آپ کو جیل جانا پڑے گا"
   },
   {
    "seq": 14,
    "start": 51.019997,
    "end": 54.44,
    "text": "آپ مجھے دڑا رہے ہیں"
   },
   {
    "seq": 15,
    "start": 54.44,
    "end": 56.079998,
    "text": "یا یہ کلت ہے"

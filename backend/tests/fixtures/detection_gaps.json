 "call7": {
  "call_id": "CALL-0007",
  "transcript": [
   {
    "seq": 0,
    "start": 0.0,
    "end": 14.76,
    "text": "एक प्रिच विकर बोल रहा हूं शहाफ इनली से मैं आपके पर्सनल लोन के पेंडिंग पेंडिंट के बारे में कॉल कर रहा हूं क्या मेरी बात रहुल मेहता जी से हो रही है"
   },
   {
    "seq": 1,
    "start": 14.76,
    "end": 18.9,
    "text": "आप बोली कितना पेंडिंग है"
   },
   {
    "seq": 2,
    "start": 18.9,
    "end": 25.9,
    "text": "सर आपकी अकाउंट में 22,000 रुपेया पैंडिंग है आप पेमेंट कब तक कर पाएंगे"
   },
   {
    "seq": 3,
    "start": 25.9,
    "end": 30.36,
    "text": "मैं अगले अप्टे तक पेमेंट पैंडिंग कोशिश करूँ गा"
   },
   {
    "seq": 4,
    "start": 30.36,
    "end": 35.66,
    "text": "ठीक है सर मैं आपको पेमेंट रिक्वेस्ट भेज रहा हूँ"
   },
   {
    "seq": 5,
    "start": 35.66,
    "end": 38.18,
    "text": "आपके phone पर एक OTP आएगा"
   },
   {
    "seq": 6,
    "start": 38.18,
    "end": 40.48,
    "text": "Please OTP मुझे बता दीजे"
   },
   {
    "seq": 7,
    "start": 40.48,
    "end": 42.96,
    "text": "मैं payment process कर देता हूँ"
   },
   {
    "seq": 8,
    "start": 42.96,
    "end": 47.68,
    "text": "OTP? क्या मुझे आपको OTP बताना जरूरी है?"
   },
   {
    "seq": 9,
    "start": 49.18,
    "end": 52.74,
    "text": "हाँ sir, जल्दी process करने के लिए बता दीजे"
   },
   {
    "seq": 10,
    "start": 52.74,
    "end": 57.08,
    "text": "नहीं, मैं OTP share नहीं करूँगा"
   },
   {
    "seq": 11,
    "start": 57.08,
    "end": 59.38,
    "text": "मैं आपके bank app से payment करूँगा"
   },
   {
    "seq": 12,
    "start": 59.38,
    "end": 65.0,
    "text": "ठीक है sir, आप bank app से payment कर सकते हैं"
   },
   {
    "seq": 13,
    "start": 65.0,
    "end": 65.6,
    "text": "धन्यवाद."
   },
   {
    "seq": 14,
    "start": 67.26,
    "end": 68.52,
    "text": "ठीक है, गुद्बाइ."
   }
  ],

# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=sqlite:///./data/compliance.db

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173

# GroqCloud API Configuration (FREE TIER - NO CREDIT CARD REQUIRED)
# Sign up at: https://console.groq.com/
# Free tier limits:
# - whisper-large-v3-turbo: 20 RPM, 2,000 RPD, 7,200 audio-sec/hr
# - openai/gpt-oss-120b: 30 RPM, 8,000 TPM (tokens per minute), 1,000 RPD, 200,000 TPD
GROQ_API_KEY=your_groq_api_key_here

# Transcription Configuration
# Primary transcription provider (do not change - assignment requirement)
TRANSCRIPTION_PROVIDER=groq
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# LLM Configuration
# Primary and ONLY LLM model (do not change - assignment requirement)
# NO silent fallback or substitution permitted
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Optional: Sarvam AI (manual hosted fallback ONLY - never automatic)
# Sign up at: https://www.sarvam.ai/
# Non-expiring trial credits: ₹100-₹1,000
# ₹30 per audio-hour
# SARVAM_API_KEY=your_sarvam_api_key_here

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
